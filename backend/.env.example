DATABASE_URL="postgresql://hrsaas:hrsaas@localhost:5432/hrsaas"
PORT=4000
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
CORS_ORIGIN="http://localhost:5173"

# Stripe (phase 7) — use test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
FRONTEND_URL="http://localhost:5173"

# Bootstrap Super Admin (seeded by `npm run prisma:seed`) — set these before running the seed
# anywhere beyond your own machine; otherwise a default local-only login is created.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Optional — profile avatar uploads. Free account at https://cloudinary.com, then
# Dashboard -> Product Environment Credentials for these three values. Leave unset for local dev
# (avatars just go to backend/uploads/avatars on disk); set them in production/Render, where the
# filesystem is wiped on every redeploy.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Link to the owner's bookkeeping in Dalilacom (payroll totals are sent there when a run is marked paid).
# The base address of the Dalilacom server, without a trailing slash. The link stays off while this is empty.
DALILACOM_API_URL=""
# Encrypts each company's signing secret in the database. Any long random string (16+ characters); keep it secret
# and do not change it afterwards, or the existing links stop working and must be made again.
ACCOUNTING_LINK_ENCRYPTION_KEY=""
# Optional: link-code attempts per company admin address per 15 minutes (default 10).
ACCOUNTING_LINK_RATE_LIMIT="10"
