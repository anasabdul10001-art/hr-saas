generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Platform / SaaS layer (not tenant-scoped)
// ─────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model SubscriptionPlan {
  id             String   @id @default(cuid())
  name           String // e.g. Free, Pro, Enterprise
  priceMonthly   Int // minor currency units (e.g. cents)
  currency       String   @default("usd")
  maxEmployees   Int
  features       Json // { attendance: true, payroll: true, ... }
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  companyId            String             @unique
  company              Company            @relation(fields: [companyId], references: [id])
  planId               String
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  invoices Invoice[]
}

model Invoice {
  id              String       @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  stripeInvoiceId String?
  amountDue       Int
  amountPaid      Int
  currency        String
  status          String // paid, open, void, uncollectible
  issuedAt        DateTime
  createdAt       DateTime     @default(now())
}

// ─────────────────────────────────────────────────────────────
// Tenant (Company) + Users
// ─────────────────────────────────────────────────────────────

model Company {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  currency     String   @default("usd")
  timezone     String   @default("UTC")
  workingDays  Json? // e.g. ["mon","tue","wed","thu","fri"]
  isSuspended  Boolean  @default(false) // Super Admin manual suspension, independent of billing status
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscription       Subscription?
  users               User[]
  departments         Department[]
  employees           Employee[]
  leaveTypes          LeaveType[]
  salaryComponents    SalaryComponent[]
  attendanceRecords   AttendanceRecord[]
  leaveRequests       LeaveRequest[]
  salaryAdvances      SalaryAdvance[]
  payrollRuns         PayrollRun[]
  auditLogs           AuditLog[]
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR
  MANAGER
  EMPLOYEE
}

model User {
  id           String    @id @default(cuid())
  companyId    String? // null for SUPER_ADMIN (platform-level user)
  company      Company?  @relation(fields: [companyId], references: [id])
  email        String    @unique
  passwordHash String
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee     Employee?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([companyId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Org structure
// ─────────────────────────────────────────────────────────────

model Department {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  managerId    String?
  manager      Employee? @relation("DepartmentManager", fields: [managerId], references: [id])
  createdAt    DateTime @default(now())

  employees Employee[]

  @@index([companyId])
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

model Employee {
  id               String           @id @default(cuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id])
  userId           String?          @unique // linked login account, if they have self-service access
  user             User?            @relation(fields: [userId], references: [id])
  firstName        String
  lastName         String
  departmentId     String?
  department       Department?      @relation(fields: [departmentId], references: [id])
  managerId        String? // reports to (another Employee)
  manager          Employee?        @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports    Employee[]       @relation("EmployeeManager")
  managedDepartments Department[]   @relation("DepartmentManager")
  position         String?
  hireDate         DateTime
  employmentStatus EmploymentStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  attendanceRecords   AttendanceRecord[]
  leaveRequests       LeaveRequest[]        @relation("LeaveRequestEmployee")
  leaveBalances       LeaveBalance[]
  salaryStructure     EmployeeSalaryComponent[]
  baseSalary          Int?
  salaryAdvances      SalaryAdvance[]        @relation("AdvanceEmployee")
  payslips            Payslip[]

  @@index([companyId])
  @@index([departmentId])
  @@index([managerId])
}

// ─────────────────────────────────────────────────────────────
// Attendance
// ─────────────────────────────────────────────────────────────

enum AttendanceSource {
  WEB
  MOBILE
  MANUAL
  DEVICE
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id])
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  checkIn    DateTime
  checkOut   DateTime?
  source     AttendanceSource @default(WEB)
  editedById String? // set when HR/Admin manually adds or corrects a record
  notes      String?
  createdAt  DateTime         @default(now())

  @@index([companyId, employeeId])
}

// ─────────────────────────────────────────────────────────────
// Leave management
// ─────────────────────────────────────────────────────────────

model LeaveType {
  id             String  @id @default(cuid())
  companyId      String
  company        Company @relation(fields: [companyId], references: [id])
  name           String
  defaultBalance Int // days per year
  isPaid         Boolean @default(true)

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@index([companyId])
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  balanceDays Float

  @@unique([employeeId, leaveTypeId, year])
}

enum LeaveRequestStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELED
}

model LeaveRequest {
  id               String              @id @default(cuid())
  companyId        String
  company          Company             @relation(fields: [companyId], references: [id])
  employeeId       String
  employee         Employee            @relation("LeaveRequestEmployee", fields: [employeeId], references: [id])
  leaveTypeId      String
  leaveType        LeaveType           @relation(fields: [leaveTypeId], references: [id])
  startDate        DateTime
  endDate          DateTime
  reason           String?
  status           LeaveRequestStatus  @default(PENDING_MANAGER)
  managerApprovedBy String?
  managerApprovedAt DateTime?
  hrApprovedBy      String?
  hrApprovedAt       DateTime?
  rejectionReason    String?
  createdAt          DateTime           @default(now())

  @@index([companyId, employeeId])
}

// ─────────────────────────────────────────────────────────────
// Payroll — flexible salary structure
// ─────────────────────────────────────────────────────────────

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum SalaryCalculationType {
  FIXED
  PERCENTAGE_OF_BASE
}

model SalaryComponent {
  id              String                 @id @default(cuid())
  companyId       String
  company         Company                @relation(fields: [companyId], references: [id])
  name            String
  type            SalaryComponentType
  calculationType SalaryCalculationType  @default(FIXED)

  employeeComponents EmployeeSalaryComponent[]

  @@index([companyId])
}

model EmployeeSalaryComponent {
  id                String          @id @default(cuid())
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id])
  salaryComponentId String
  salaryComponent   SalaryComponent @relation(fields: [salaryComponentId], references: [id])
  fixedAmount       Int? // minor units — set when the component's calculationType is FIXED
  percentage        Float? // e.g. 7.5 for 7.5% of base — set when calculationType is PERCENTAGE_OF_BASE

  @@unique([employeeId, salaryComponentId])
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
  PAID
}

model PayrollRun {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollRunStatus @default(DRAFT)
  runAt       DateTime?
  createdAt   DateTime         @default(now())

  payslips Payslip[]

  @@index([companyId])
}

model Payslip {
  id           String     @id @default(cuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id])
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  grossPay     Int // minor units
  totalDeductions Int
  netPay       Int
  breakdown    Json // itemized earnings/deductions/advance installments
  createdAt    DateTime   @default(now())

  @@index([payrollRunId, employeeId])
}

// ─────────────────────────────────────────────────────────────
// Salary advances / loans
// ─────────────────────────────────────────────────────────────

enum AdvanceStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  REPAID
}

model SalaryAdvance {
  id                String        @id @default(cuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id])
  employeeId        String
  employee          Employee      @relation("AdvanceEmployee", fields: [employeeId], references: [id])
  amount            Int // minor units
  installmentsCount Int
  status            AdvanceStatus @default(PENDING_MANAGER)
  reason            String?
  createdAt         DateTime      @default(now())

  installments AdvanceInstallment[]

  @@index([companyId, employeeId])
}

model AdvanceInstallment {
  id              String        @id @default(cuid())
  advanceId       String
  advance         SalaryAdvance @relation(fields: [advanceId], references: [id])
  amount          Int
  dueDate         DateTime
  paidInPayrollRunId String?
  isPaid          Boolean       @default(false)

  @@index([advanceId])
}

// ─────────────────────────────────────────────────────────────
// Audit log
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. "attendance.manual_edit", "payroll.run"
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([companyId])
}
